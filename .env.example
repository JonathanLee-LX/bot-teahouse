# 密钥配置模板：复制为 .env 并填入真实值
#   cp .env.example .env
# .env 已在 .gitignore 中，不会提交到 Git。
# 本机（Hatch）实验环境不需要 .env：run.sh 会自动取动态短时凭证。

# DeepSeek API key（跑实验的默认模型）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Cloudflare API token（仅 wrangler 实验部署需要；只跑 room 协同实验可不填）
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
